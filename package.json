{
  "name": "kriseva-attest-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "verify:claims": "node scripts/verify-claims.mjs",
    "checksums": "node scripts/build-checksums.mjs",
    "release:public": "node scripts/build-public-release.mjs",
    "capture": "node scripts/capture-artifacts.mjs all",
    "capture:prototype": "node scripts/capture-artifacts.mjs prototype",
    "capture:wireframes": "node scripts/capture-artifacts.mjs wireframes",
    "wireframes:build": "node scripts/build-wireframes.mjs",
    "deck": "node scripts/build-deck.mjs",
    "deck:render": "node scripts/render-deck.mjs",
    "video": "bash scripts/build-video.sh",
    "video:verify": "bash scripts/verify-video.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "playwright": "^1.59.1",
    "sharp": "^0.35.3"
  }
}
